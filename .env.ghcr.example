# Default GHCR deployment target for this fork.
# Keep this lowercase because Docker image references require lowercase owners.
# Override these values only when pinning a release tag or targeting a different publishing fork.
OPEN_DESIGN_IMAGE_OWNER=jzkk720
OPEN_DESIGN_IMAGE_REPOSITORY=open-design
OPEN_DESIGN_IMAGE_TAG=latest

# Optional: bootstrap the container stack against a host-side Ollama.
# Replace the model with one present in `ollama list` on the Docker host.
# OD_DEFAULT_MODE=api
# OD_DEFAULT_API_PROTOCOL=ollama
# OD_DEFAULT_API_BASE_URL=http://host.docker.internal:11434
# OD_DEFAULT_API_MODEL=qwen3.5:35b-a3b

OD_WEB_PORT=7831
# Required when the daemon binds 0.0.0.0 in container mode.
# Generate one with: openssl rand -hex 32
OD_API_TOKEN=replace-with-32-byte-hex
